:80 {
    root * /app/root
    encode gzip

    @root path /
    rewrite @root /dist/index.html

    @php path /index.php /api/* /__reload
    handle @php {
        rewrite * /index.php
        php_server
    }

    handle /public/* {
        root * /app
        file_server
    }

    handle {
        file_server
    }
}
